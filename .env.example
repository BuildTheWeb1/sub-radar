# Neon Postgres connection string (pooled)
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CRON_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
# Session cookie from a logged-in reddit.com browser tab (DevTools -> Network ->
# any reddit.com request -> Cookie header). Required for lib/reddit-http.ts to
# pass Reddit's bot block — validated on Vercel production with a logged-in
# session cookie specifically (a logged-out cookie was not tested). The token_v2
# value inside it expires in ~24h; reddit_session lasts ~6 months — it's unclear
# which one Reddit's JSON endpoints actually check, so budget for possibly
# needing to refresh this daily until observed otherwise. No self-refresh path
# exists (tested: an unauthenticated fetch to reddit.com/ does not yield a
# working cookie), so this must be refreshed manually when scraping/guidelines
# fetches start failing.
REDDIT_COOKIE=
